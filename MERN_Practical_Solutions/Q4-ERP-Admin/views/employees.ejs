<h2>Employees</h2><a href="/logout">Logout</a><form method="post" action="/add"><input name="name" placeholder="Name" required><input name="email" type="email" placeholder="Email" required><input name="salary" type="number" placeholder="Basic salary" required><input name="allowance" type="number" placeholder="Allowance" value="0"><input name="deduction" type="number" placeholder="Deduction" value="0"><button>Add employee</button></form><table border="1"><tr><th>ID</th><th>Name</th><th>Email</th><th>Net salary</th><th>Update</th><th>Delete</th></tr><%rows.forEach(e=>{%><tr><td><%=e.empid%></td><td><%=e.name%></td><td><%=e.email%></td><td><%=e.salary+e.allowance-e.deduction%></td><td><form method="post" action="/edit/<%=e._id%>"><input name="name" value="<%=e.name%>"><input name="salary" value="<%=e.salary%>"><input name="allowance" value="<%=e.allowance%>"><input name="deduction" value="<%=e.deduction%>"><button>Save</button></form></td><td><form method="post" action="/delete/<%=e._id%>"><button>Delete</button></form></td></tr><%})%></table>